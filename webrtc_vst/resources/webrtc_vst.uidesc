<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
    <fonts/>
    <colors>
        <color name="Background" rgba="#121417ff"/>
        <color name="LabelText" rgba="#e2e8f0ff"/>
        <color name="Frame" rgba="#282c34ff"/>
        <color name="InputText" rgba="#18c460ff"/>
        <color name="Header" rgba="#18c460ff"/>
    </colors>
    <template background-color="Background" background-color-draw-style="filled" class="CViewContainer" mouse-enabled="true" name="view" opacity="1" origin="0, 0" size="480, 290" transparent="false">
        <view back-color="Frame" class="CTextLabel" font="~ NormalFontVeryBig" font-color="Header" frame-color="Frame" frame-width="1" mouse-enabled="false" opacity="1" origin="20, 15" size="440, 30" style-round-rect="true" text-alignment="center" title="VDO.Ninja WebRTC Bridge" transparent="false"/>
        
        <view back-color="Background" class="CTextLabel" font="~ NormalFont" font-color="LabelText" frame-color="Background" frame-width="0" mouse-enabled="false" opacity="1" origin="20, 60" size="160, 20" text-alignment="left" title="Connection Mode" transparent="true"/>
        <view class="COptionMenu" control-tag="Param::Mode" menu-popup-style="true" default-value="0" font="~ NormalFont" font-color="InputText" frame-color="Frame" frame-width="1" max-value="1" min-value="0" mouse-enabled="true" opacity="1" origin="200, 58" size="240, 24" style-3D-in="false" style-no-frame="false" text-alignment="center" transparent="false"/>

        <view back-color="Background" class="CTextLabel" font="~ NormalFont" font-color="LabelText" frame-color="Background" frame-width="0" mouse-enabled="false" opacity="1" origin="20, 100" size="160, 20" text-alignment="left" title="Stream ID" transparent="true"/>
        <view class="CTextEdit" control-tag="Param::StreamId" font="~ NormalFont" font-color="InputText" frame-color="Frame" frame-width="1" immediate-text-change="false" mouse-enabled="true" opacity="1" origin="200, 98" size="240, 24" style-3D-in="false" style-no-frame="false" style-round-rect="true" text-alignment="left" text-inset="6, 2" transparent="false" wants-focus="true"/>

        <view back-color="Background" class="CTextLabel" font="~ NormalFont" font-color="LabelText" frame-color="Background" frame-width="0" mouse-enabled="false" opacity="1" origin="20, 140" size="160, 20" text-alignment="left" title="Room Name" transparent="true"/>
        <view class="CTextEdit" control-tag="Param::RoomName" font="~ NormalFont" font-color="InputText" frame-color="Frame" frame-width="1" immediate-text-change="false" mouse-enabled="true" opacity="1" origin="200, 138" size="240, 24" style-3D-in="false" style-no-frame="false" style-round-rect="true" text-alignment="left" text-inset="6, 2" transparent="false" wants-focus="true"/>

        <view back-color="Background" class="CTextLabel" font="~ NormalFont" font-color="LabelText" frame-color="Background" frame-width="0" mouse-enabled="false" opacity="1" origin="20, 180" size="160, 20" text-alignment="left" title="Password" transparent="true"/>
        <view class="CTextEdit" control-tag="Param::Password" font="~ NormalFont" font-color="InputText" frame-color="Frame" frame-width="1" immediate-text-change="false" mouse-enabled="true" opacity="1" origin="200, 178" size="240, 24" style-3D-in="false" style-no-frame="false" style-round-rect="true" text-alignment="left" text-inset="6, 2" transparent="false" wants-focus="true"/>

        <view back-color="Background" class="CTextLabel" font="~ NormalFont" font-color="LabelText" frame-color="Background" frame-width="0" mouse-enabled="false" opacity="1" origin="20, 220" size="160, 20" text-alignment="left" title="Status" transparent="true"/>
        <view class="CParamDisplay" control-tag="Param::Status" font="~ NormalFont" font-color="InputText" frame-color="Frame" frame-width="1" mouse-enabled="false" opacity="1" origin="200, 218" size="240, 24" style-3D-in="false" style-no-frame="false" style-round-rect="true" text-alignment="left" text-inset="6, 2" transparent="false"/>

        <view back-color="Background" class="CTextLabel" font="~ NormalFontSmall" font-color="LabelText" frame-color="Background" frame-width="0" mouse-enabled="false" opacity="1" origin="20, 260" size="440, 20" text-alignment="center" title="Advanced: Handshake URL is customizable via VST host state if needed." transparent="true"/>
    </template>
    <variables/>
    <custom/>
    <bitmaps/>
    <control-tags>
        <control-tag name="Param::Mode" tag="0"/>
        <control-tag name="Param::StreamId" tag="1"/>
        <control-tag name="Param::RoomName" tag="2"/>
        <control-tag name="Param::HandshakeUrl" tag="3"/>
        <control-tag name="Param::Password" tag="4"/>
        <control-tag name="Param::DisableEncryption" tag="5"/>
        <control-tag name="Param::Status" tag="6"/>
    </control-tags>
</vstgui-ui-description>
